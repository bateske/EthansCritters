@@ -34,6 +34,8 @@ static std::vector<uint8_t> image, vfile;
 static vcard::Card vc;
 static bool useVc;
 static long reads, failAfter = -1;      // failAfter >= 0: that many more reads work
+static long streamCalls, streamFailAfter = -1;   // sd::stream() calls; as failAfter, in blocks
+static long crossings;                  // fat::stream() ranges checked that span runs
 
 namespace sd {
 bool init() { return (useVc || !image.empty()) && failAfter != 0; }
@@ -54,9 +56,24 @@ bool read(uint32_t lba, uint8_t *dst) {
     memcpy(dst, image.data() + (size_t)lba * 512, 512);
     return true;
 }
+// sd::stream() over the same blocks, one at a time (on the board fn gets
+// block k while k + 1 arrives; the order is the same). streamFailAfter >= 0:
+// that many more blocks arrive, then the stream fails.
+bool stream(uint32_t lba, uint32_t n, uint8_t *buf0, uint8_t *buf1, BlockFn fn, void *ctx) {
+    streamCalls++;
+    for (uint32_t k = 0; k < n; k++) {
+        if (streamFailAfter == 0) return false;
+        if (streamFailAfter > 0) streamFailAfter--;
+        uint8_t *b = (k & 1) ? buf1 : buf0;
+        if (!read(lba + k, b)) return false;
+        fn(b, ctx);
+    }
+    return true;
+}
 }  // namespace sd
 
 alignas(4) static uint8_t buf[512];
+alignas(4) static uint8_t sbuf[2][512];
 
 // The contents run_tests.py gives a file.
 static uint8_t byteAt(uint32_t i, uint32_t seed) { return (uint8_t)(i * 7 + seed * 13 + (i >> 9)); }
@@ -82,6 +99,73 @@ static void readAll(const fat::Run *r, uint32_t n, uint32_t size, uint32_t seed)
     CHECK(!fat::read(r, n, blocks, buf));
 }
 
+// fat::stream() of blocks [k, k + n): every block once, in order, with the
+// file's bytes, and one sd::stream() per run the range touches.
+struct Seq { uint32_t next, size, seed, bad, calls; };
+static void seqBlock(const uint8_t *b, void *ctx) {
+    Seq &q = *(Seq *)ctx;
+    for (uint32_t j = 0; j < 512 && q.next * 512 + j < q.size; j++) q.bad += b[j] != byteAt(q.next * 512 + j, q.seed);
+    q.next++;
+    q.calls++;
+}
+
+static void streamRange(const fat::Run *r, uint32_t nr, uint32_t size, uint32_t seed, uint32_t k, uint32_t n) {
+    uint32_t pieces = 0, at = 0;
+    for (uint32_t i = 0; i < nr; i++, at += r[i - 1].blocks)
+        if (n && k < at + r[i].blocks && k + n > at) pieces++;
+    Seq q = {k, size, seed, 0, 0};
+    streamCalls = 0;
+    CHECK(fat::stream(r, (uint8_t)nr, k, n, sbuf[0], sbuf[1], seqBlock, &q));
+    CHECK_EQ(q.calls, n);
+    CHECK_EQ(q.bad, 0);
+    CHECK_EQ(streamCalls, pieces);
+    crossings += pieces > 1;
+}
+
+static void streamAll(const fat::Run *r, uint32_t nr, uint32_t size, uint32_t seed) {
+    uint32_t blocks = (size + 511) / 512;
+    streamRange(r, nr, size, seed, 0, blocks);                  // the whole file
+    streamRange(r, nr, size, seed, 0, 0);                       // nothing: true, no command
+    if (blocks) streamRange(r, nr, size, seed, blocks - 1, 1);  // the last block
+    // Every run boundary, crossed by 1..3 blocks each side, and a range
+    // from the middle of one run to the middle of the one after next.
+    uint32_t at = 0;
+    for (uint32_t i = 0; i + 1 < nr; i++) {
+        at += r[i].blocks;
+        for (uint32_t a = 1; a <= 3 && a <= at; a++)
+            for (uint32_t b = 1; b <= 3 && at + b <= blocks; b++) streamRange(r, nr, size, seed, at - a, a + b);
+        if (i + 2 < nr) streamRange(r, nr, size, seed, at - r[i].blocks / 2, r[i].blocks / 2 + r[i + 1].blocks + 1);
+    }
+    // Pseudo-random ranges.
+    uint32_t x = 12345 + size;
+    for (uint32_t t = 0; blocks && t < 40; t++) {
+        x = x * 1103515245u + 12345u;
+        uint32_t k = (x >> 8) % blocks;
+        x = x * 1103515245u + 12345u;
+        uint32_t n = 1 + (x >> 8) % (blocks - k < 40 ? blocks - k : 40);
+        streamRange(r, nr, size, seed, k, n);
+    }
+    // Past the end: refused before anything is read.
+    Seq q = {0, size, seed, 0, 0};
+    streamCalls = 0;
+    CHECK(!fat::stream(r, (uint8_t)nr, blocks, 1, sbuf[0], sbuf[1], seqBlock, &q));
+    if (blocks) CHECK(!fat::stream(r, (uint8_t)nr, 1, blocks, sbuf[0], sbuf[1], seqBlock, &q));
+    CHECK(!fat::stream(r, (uint8_t)nr, 1, 0xFFFFFFFFu, sbuf[0], sbuf[1], seqBlock, &q));
+    CHECK(!fat::stream(r, (uint8_t)nr, blocks + 1, 0, sbuf[0], sbuf[1], seqBlock, &q));
+    CHECK_EQ(q.calls, 0);
+    CHECK_EQ(streamCalls, 0);
+    // The card failing part way: false, and fn has seen exactly the blocks
+    // before the failure, all good.
+    for (uint32_t f = 0; f < blocks && f < 12; f++) {
+        Seq w = {0, size, seed, 0, 0};
+        streamFailAfter = f;
+        CHECK(!fat::stream(r, (uint8_t)nr, 0, blocks, sbuf[0], sbuf[1], seqBlock, &w));
+        streamFailAfter = -1;
+        CHECK_EQ(w.calls, f);
+        CHECK_EQ(w.bad, 0);
+    }
+}
+
