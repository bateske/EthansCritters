@@ -77,4 +78,20 @@ uint8_t open(const char *name, Run *out, uint8_t maxRuns, uint8_t *buf);
 // False: past the end, or the card did not deliver it.
 bool read(const Run *run, uint32_t nRuns, uint32_t k, uint8_t *dst);
 
+// Blocks [k, k + n) of a file through its runs, by sd::stream(): one
+// multi-block read per run the range touches (so a range across a run
+// boundary costs a second command), each block handed to fn(block, ctx)
+// once, in order, while the next arrives by DMA into the other buffer.
+// buf0/buf1 are 512 B each, 4-byte aligned (gfx_chunkScratch() and the
+// half after it, between gfx_wait() and the next flush); a block is only
+// valid during its fn call. False: the range runs past the end (refused
+// before anything is read), or the card failed part way (fn has seen a
+// first part of the range, not always every block that arrived: fn gets a
+// block once the next one's token is in, so a timeout loses the block
+// before it too; see sd::stream() for what to do next).
+// (In its own file, FatStream.cpp, so it is in no image that does not
+// call it.)
+bool stream(const Run *run, uint8_t nRuns, uint32_t k, uint32_t n, uint8_t *buf0, uint8_t *buf1,
+            sd::BlockFn fn, void *ctx);
+
 }  // namespace fat
diff --git a/platform/board/arduino/CHGame/libraries/CHSd/src/FatStream.cpp b/platform/board/arduino/CHGame/libraries/CHSd/src/FatStream.cpp
new file mode 100644
index 0000000..251f299
--- /dev/null
+++ b/platform/board/arduino/CHGame/libraries/CHSd/src/FatStream.cpp
@@ -0,0 +1,32 @@
+// FatStream.cpp - fat::stream(), see Fat.h: a file's blocks through
+// sd::stream(), split where the file's runs split. Lifted from CHStlView's
+// card::stream(), with the range checked before anything is read. A file
+// of its own so that Fat.cpp, and with it every image that only reads
+// blocks one at a time, stays byte for byte what it was. Like Fat.cpp it
+// runs on the PC too: the simulator's card and the host tests supply
+// sd::stream().
+#pragma GCC optimize("Os", "no-ipa-sra")
+#include "Fat.h"
+#include "SdSpi.h"
+
+namespace fat {
+
+bool stream(const Run *r, uint8_t nRuns, uint32_t k, uint32_t n, uint8_t *buf0, uint8_t *buf1,
+            sd::BlockFn fn, void *ctx) {
+    const Run *end = r + nRuns;
+    uint32_t len = 0;
+    for (const Run *p = r; p < end; p++) len += p->blocks;
+    if (k > len || n > len - k) return false;
+    // In range, so the loop ends inside the runs.
+    for (; n; r++) {
+        if (k >= r->blocks) { k -= r->blocks; continue; }
+        uint32_t take = r->blocks - k;
+        if (take > n) take = n;
+        if (!sd::stream(r->lba + k, take, buf0, buf1, fn, ctx)) return false;
+        n -= take;
+        k = 0;
+    }
+    return true;
+}
+
+}  // namespace fat
