diff --git a/platform/board/arduino/CHGame/libraries/CHGfx/src/CHGfx.h b/platform/board/arduino/CHGame/libraries/CHGfx/src/CHGfx.h
index f5081d1..af404cb 100644
--- a/platform/board/arduino/CHGame/libraries/CHGfx/src/CHGfx.h
+++ b/platform/board/arduino/CHGame/libraries/CHGfx/src/CHGfx.h
@@ -342,6 +342,32 @@ void gfx_fillCircle(int cx, int cy, int r, uint8_t c);
  * (the opaque even-x case runs at memcpy speed). */
 void gfx_blit(const uint8_t *spr, int x, int y, int w, int h, int transparent);
 
+/* Keyed word blit: art streamed from a card or kept raw in RAM. Source
+ * rows are wWords (1..16, up to 128 px) 32-bit words each, src 4-byte
+ * aligned, packed like the framebuffer (pixel i of a word in bits
+ * 4i..4i+3); colour 15 is transparent. Any x: each row is funnel-shifted
+ * into the framebuffer's words and merged under a mask of its opaque
+ * pixels, so it costs the same at every x. Clipped to the clip
+ * rectangle. ~540 bytes of SRAM when used. flags:
+ *   GFX_B4_FLIPH   mirror the whole padded width (wWords * 8 px)
+ *   GFX_B4_REMAP   pixel = remap[pixel] (16 entries; 15 stays transparent,
+ *                  and an entry of 15 makes that colour transparent)
+ *   GFX_B4_SOLID   every opaque pixel in the ink colour, GFX_B4_INK(c)
+ *                  (0..14; 15 is the key, so it draws nothing): a white
+ *                  hit flash, a silhouette
+ *   GFX_B4_DITHER  draw only where a 4x4 Bayer threshold < level (0..16:
+ *                  0 nothing, 8 half, 16 all), anchored to the screen so
+ *                  a moving sprite's stipple does not crawl; without the
+ *                  flag level is ignored
+ * remap may be nullptr unless GFX_B4_REMAP is set. */
+#define GFX_B4_FLIPH   0x01
+#define GFX_B4_REMAP   0x02
+#define GFX_B4_SOLID   0x04
+#define GFX_B4_DITHER  0x08
+#define GFX_B4_INK(c)  ((uint8_t)(((c) & 15) << 4))
+void gfx_blit4k(const uint8_t *src, int x, int y, int wWords, int h, uint8_t flags,
+                const uint8_t *remap = nullptr, uint8_t level = 16);
+
 /* ------------------------------------------------------------------ */
 /* Shapes                                                              */
 /* ------------------------------------------------------------------ */
diff --git a/platform/board/arduino/CHGame/libraries/CHGfx/src/CHGfx_blit4k.cpp b/platform/board/arduino/CHGame/libraries/CHGfx/src/CHGfx_blit4k.cpp
new file mode 100644
index 0000000..d9f6655
--- /dev/null
+++ b/platform/board/arduino/CHGame/libraries/CHGfx/src/CHGfx_blit4k.cpp
@@ -0,0 +1,163 @@
+/*
+ * CHGfx_blit4k.cpp - gfx_blit4k(): a keyed blit of raw 4 bpp words at any
+ * x, with flip, remap, solid ink and an ordered-dither fade.
+ *
+ * Made for art streamed from an SD card into a RAM cache, where frames
+ * arrive as whole words: a source row is wWords words, so a row lands in
+ * the framebuffer as wWords + 1 word read-modify-writes whatever x is.
+ * At x % 8 == s the output word is (cur << 4s) | (prev >> (32 - 4s)), the
+ * classic funnel shift, with colour 15 shifted in on both sides.
+ *
+ * Transparency is found eight pixels at a time (SWAR): a nibble is 15
+ * when all its bits are set, so
+ *     t = c & c >> 1;  t &= t >> 2;  t &= 0x11111111
+ * leaves bit 0 of each key nibble, and t * 15 is the key mask. The
+ * opaque mask m = ~that, ANDed with the clip edges and the dither mask;
+ * the store is (d & ~m) | (c & m), skipped when m is 0 (most words at a
+ * sprite's edges).
+ *
+ * Split in two for RAM: the setup (clip, masks, tables) runs once a call
+ * from flash, and only the row loops sit in SRAM (each GFX_RAMFUNC costs
+ * its size in RAM; all of it in SRAM was ~820 bytes, the rows alone are
+ * ~540). Each source row is first copied (flipped, remapped, inked) into
+ * a row of words on the stack with a key word either side; the merge loop
+ * then reads two neighbours per output word, visits only the columns
+ * inside the clip and has no per-flag branches: ~27 instructions a word
+ * stored, ~22 a word left alone. Remap goes nibble by nibble: a 256-entry
+ * byte-pair table costs ~256 steps to build, as much as a 24x21 sprite's
+ * remap, and 256 bytes of stack. An ink of 15 is the key: nothing shows.
+ *
+ * The row function keeps its frame pointer on purpose: with
+ * -msave-restore GCC may otherwise save registers through __riscv_save_N,
+ * which lives in flash.
+ */
+#include "CHGfx_internal.h"
+
+#ifdef CHSIM
+#define B4_NOSAVE
+#else
+#define B4_NOSAVE __attribute__((optimize("no-omit-frame-pointer")))
+#endif
+
+#define B4_MAXW (GFX_W / 8)
+
+namespace {
+struct B4Job {
+    const uint32_t *row;            /* the first source row drawn */
+    uint32_t *fb;                   /* its framebuffer row, at word column xw (output word 0) */
+    int words, rows, y;             /* source words a row; rows drawn; the first one's y */
+    int oa, ob;                     /* output words inside the clip: [oa, ob) */
+    uint32_t sh, rs;                /* funnel: cur << sh | (prev >> 1) >> rs */
+    uint32_t ma, mb;                /* clip masks of words oa and ob - 1 */
+    uint32_t ink, dither[4];        /* solid colour in every nibble (not 15); Bayer mask by y & 3 */
+    uint8_t remap[16];              /* 15 kept */
+    bool flip, rm, solid;
+};
+}
+
+/* The key mask of eight pixels: 0xF in each nibble that is 15. */
+static GFX_INLINE uint32_t keyMask(uint32_t c) {
+    uint32_t q = c & (c >> 1);
+    q &= q >> 2;
+    return (q & 0x11111111u) * 15;
+}
+
+GFX_RAMFUNC(blit4k) B4_NOSAVE static void blit4kRows(const B4Job &j) {
+    uint32_t rb[B4_MAXW + 2];       /* key, the row, key */
+    int words = j.words;
+    rb[0] = ~0u;
+    rb[words + 1] = ~0u;
+    bool plain = !(j.flip | j.rm | j.solid);
+    const uint32_t *row = j.row;
+    uint32_t *fb = j.fb;
+    for (int n = j.rows, y = j.y; n > 0; n--, y++, row += words, fb += GFX_FB_STRIDE / 4) {
+        uint32_t *w = rb + 1, *we = w + words;
+        if (plain) {
+            for (const uint32_t *s = row; w < we;) *w++ = *s++;
+        } else {
+            for (const uint32_t *s = row + words; w < we;) {
+                uint32_t v;
+                if (j.flip) {               /* words from the end, nibbles reversed */
+                    v = *--s;
+                    v = (v >> 16) | (v << 16);
+                    v = ((v >> 8) & 0x00FF00FFu) | ((v & 0x00FF00FFu) << 8);
+                    v = ((v >> 4) & 0x0F0F0F0Fu) | ((v & 0x0F0F0F0Fu) << 4);
+                } else {
+                    v = row[w - rb - 1];
+                }
+                if (j.rm) {
+                    uint32_t u = 0;
+                    for (uint32_t b = 0; b < 32; b += 4) u |= (uint32_t)j.remap[(v >> b) & 15] << b;
+                    v = u;
+                }
+                if (j.solid) {              /* the ink wherever it is not the key */
+                    uint32_t k = keyMask(v);
+                    v = (v & k) | (j.ink & ~k);
+                }
+                *w++ = v;
+            }
+        }
+        /* merge: output word o is rb[o + 1] funnelled with rb[o] */
+        uint32_t dm = j.dither[y & 3], em = j.ma, sh = j.sh, rs = j.rs;
+        const uint32_t *r = rb + j.oa;
+        for (uint32_t *d = fb + j.oa, *de = fb + j.ob; d < de; d++, r++) {
+            uint32_t c = (r[1] << sh) | ((r[0] >> 1) >> rs);
+            if (d == de - 1) em &= j.mb;
+            uint32_t m = ~keyMask(c) & dm & em;
+            em = ~0u;
+            if (m) *d = (*d & ~m) | (c & m);
+        }
+    }
+}
+
+void gfx_blit4k(const uint8_t *src, int x, int y, int wWords, int h, uint8_t flags,
+                const uint8_t *remap, uint8_t level) {
+    const GfxClip k = gfx__clip;
+    if (!(flags & GFX_B4_DITHER) || level > 16) level = 16;
+    int y1 = y + h;
+    if (y1 > k.y1) y1 = k.y1;
+    int r0 = y < k.y0 ? k.y0 - y : 0;
+    if (wWords <= 0 || wWords > B4_MAXW || !level || y + r0 >= y1 || k.x1 <= k.x0) return;
+
+    /* Output word o lands on framebuffer word column xw + o; the first
+     * and last inside the clip may be only partly inside. */
+    B4Job j;
+    int xw = x >> 3;
+    j.sh = (uint32_t)(x & 7) * 4;
+    j.rs = 31 - j.sh;                       /* (prev >> 1) >> rs: no shift by 32 at sh 0 */
+    int nOut = wWords + (j.sh != 0);
+    j.oa = (k.x0 >> 3) - xw;
+    j.ob = ((k.x1 - 1) >> 3) - xw + 1;
+    j.ma = j.oa >= 0 ? ~0u << ((k.x0 & 7) * 4) : ~0u;
+    j.mb = j.ob <= nOut ? ~0u >> ((7 - ((k.x1 - 1) & 7)) * 4) : ~0u;
+    if (j.oa < 0) j.oa = 0;
+    if (j.ob > nOut) j.ob = nOut;
+    if (j.oa >= j.ob) return;
+
+    j.flip = flags & GFX_B4_FLIPH;
+    j.rm = (flags & GFX_B4_REMAP) && remap;
+    if (j.rm) {
+        for (uint32_t i = 0; i < 15; i++) j.remap[i] = remap[i] & 15;
+        j.remap[15] = 15;
+    }
+    j.solid = flags & GFX_B4_SOLID;
+    j.ink = (uint32_t)(flags >> 4) * 0x11111111u;
+    /* Bayer thresholds packed a row per 16 bits, nibble i = column i; the
+     * framebuffer words start on multiples of 8, so a row's mask is the
+     * same four columns twice. */
+    for (uint32_t r = 0; r < 4; r++) {
+        uint32_t b = (r & 2 ? 0x5D7F91B3u : 0x6E4CA280u) >> ((r & 1) * 16), m = ~0u;
+        if (level < 16) {
+            m = 0;
+            for (uint32_t i = 0; i < 16; i += 4)
+                if (((b >> i) & 15) < level) m |= 0x000F000Fu << i;
+        }
+        j.dither[r] = m;
+    }
+    j.words = wWords;
+    j.row = (const uint32_t *)src + r0 * wWords;
+    j.fb = (uint32_t *)gfx_fb + (y + r0) * (GFX_FB_STRIDE / 4) + xw;
+    j.rows = y1 - y - r0;
+    j.y = y + r0;
+    blit4kRows(j);
+}
